<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- RimWorld 1.7 runs on the .NET 10 "Waylith" runtime (see
         RimWorld.runtimeconfig.json) and ships its managed assemblies in the
         install root instead of RimWorldLinux_Data/Managed. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SocialDrugPolicy</AssemblyName>
    <RootNamespace>SocialDrugPolicy</RootNamespace>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RimWorldPath>/home/gapho/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
    <SteamModContentFolder>/home/gapho/.local/share/Steam/steamapps/workshop/content/294100</SteamModContentFolder>
    <!-- HarmonyLib, taken from the Harmony workshop mod (id 2009463077). RimWorld
         does not ship a Harmony assembly of its own. The 1.7 build is Harmony 3.0. -->
    <HarmonyDll>$(SteamModContentFolder)/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <!-- Private=false on every reference: nothing but our own dll may end up in
       the mod's Assemblies folder. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 1.7 merges the old UnityEngine.*Module assemblies into UnityStubs. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)/UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
